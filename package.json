		"esbuild": "^0.28.2",
		"happy-dom": "^15.11.7",
		"lefthook": "^2.2.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typescript": "^5.9.3",
		"vitest": "^2.1.9",
		"wxt": "^0.19.29"
	},
	"packageManager": "pnpm@9.15.5"
}
