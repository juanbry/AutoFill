{
	"name": "job-autofill",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"prepare": "wxt prepare && lefthook install",
		"test": "vitest run",
